# 配り方の宣言。**共通の lib_release.sh / product_release.sh が読む**(A §9.8)。
#
# ⚠ 名指しするのは**配備専任**のコマンド。版を上げるものを呼ぶと、1回の
#   リリースで版が2つ進む。deploy_web.sh は版も公開 push も触らない
#   (旧 commit_push_deploy.sh から、その半分を落として改名した)。
WEB_DEPLOY="./deploy_web.sh"

# 配る先の Cloudflare 口座。**同じ端末に複数ある** ——
# 最後に login したものへ向かうと別会社へ配りに行く(2026-09-05 に落ちた)。
# 実体は Entamy/.env の CF_<名前>_ACCOUNT_ID / _DEPLOY_TOKEN。
CF_ACCOUNT=ENTAMY

# 版の写しを揃える(package.json / src の定数 / 公開ページのバッジ)。
# **commit の前**に共通側が呼ぶ。commit するコマンドを書かないこと。
VERSION_SYNC="node build-scripts/bump.js sync --no-commit"
